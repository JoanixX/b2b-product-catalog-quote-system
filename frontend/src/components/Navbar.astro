---
import { brand } from '../lib/demo';
---
<header class="site-header">
  <div class="container nav-inner">
    <a class="identity" href="/" aria-label={`${brand.name}, inicio`}>
      {brand.logoUrl ? <img src={brand.logoUrl} alt="" width="32" height="32" /> : <span class="mark" aria-hidden="true"><span></span><span></span><span></span></span>}
      <span>{brand.name}<small> / demo comercial</small></span>
    </a>
    <nav aria-label="Navegación principal">
      <a href="/#como-funciona">Cómo funciona</a>
      <a href="/solicitud">Nueva solicitud</a>
      <a class="button button-primary" href="/demo">Abrir demo <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
<style>
  .site-header { background:#fff; border-bottom:1px solid var(--line); position:sticky; top:0; z-index:20; }
  .nav-inner { min-height:72px; display:flex; align-items:center; justify-content:space-between; gap:20px; }
  .identity { display:inline-flex; align-items:center; gap:11px; color:var(--primary-dark); font:800 1.25rem Manrope,sans-serif; text-decoration:none; letter-spacing:-.05em; white-space:nowrap; }
  .identity small { color:var(--muted); font:600 .65rem 'DM Sans',sans-serif; letter-spacing:.1em; text-transform:uppercase; vertical-align:middle; }
  .mark { width:32px; height:32px; border-radius:9px; background:var(--primary); display:flex; align-items:center; justify-content:center; gap:2px; transform:rotate(-8deg); }
  .mark span { display:block; width:4px; height:15px; border-radius:3px; background:#fff; }
  .mark span:first-child { height:9px; transform:translateY(3px); }
  .mark span:last-child { height:20px; transform:translateY(-2px); background:#6fe0cf; }
  nav { display:flex; align-items:center; gap:22px; }
  nav>a:not(.button) { text-decoration:none; color:var(--muted); font-weight:700; font-size:.87rem; }
  nav>a:not(.button):hover { color:var(--primary); }
  nav .button { min-height:39px; font-size:.82rem; padding:.6rem .85rem; }
  @media(max-width:720px) { .nav-inner { min-height:66px; } .identity small,nav>a:not(.button) { display:none; } nav { gap:8px; } }
</style>
